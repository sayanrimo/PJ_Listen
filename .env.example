# Copy this file to .env and fill in your actual values.
# .env is loaded automatically via python-dotenv — no need to `export` anything.

# Embedding backend (Azure AI Foundry) — see config/config.yaml embed.azure_endpoint_env / azure_api_key_env
AZURE_EMBEDDING_ENDPOINT=https://your-embedding-resource.services.ai.azure.com/openai/v1
AZURE_EMBEDDING_API_KEY=your-embedding-key-here

# GPT calibration backend (only required if features.run_llm_calibration: true)
AZURE_GPT_ENDPOINT=https://your-gpt-resource.openai.azure.com
AZURE_GPT_API_KEY=your-gpt-key-here
